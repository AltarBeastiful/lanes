# Lanes configuration, written by `lanes init`. Changing it needs the allow-config label.

# Where pull requests live, and where tickets live.
host = {{ config.host | toml }}
tracker = {{ config.tracker | toml }}

# How this repository runs its tests. The gates don't run this command: they run
# the whole suite through .lanes/runner.
test_command = {{ config.test_command | toml }}

# At most this many lanes run at once in this repository.
max_lanes = {{ config.max_lanes | toml }}

# Whether Codex may read this repository's code. When false, Claude with an
# adversarial prompt takes Codex's place as second reviewer.
codex_allowed = {{ config.codex_allowed | toml }}

# Who reviews each tier once CI is green; an empty list means CI only.
[reviewers]
{%- for tier, reviewers in config.reviewers %}
{{ tier }} = {{ reviewers | toml }}
{%- endfor %}
